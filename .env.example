# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for EVOC Labs website
#
# Copy this file to `.env.local` and fill in the real values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Careers application form (POST /api/apply) — Gmail SMTP.
# This account authenticates and SENDS the application emails.
#
# Use a Gmail "App Password" (16 characters), NOT the normal account password.
# Requires 2-Step Verification enabled, then generate one at:
#   https://myaccount.google.com/apppasswords
GMAIL_USER=Sociodesk.help@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Optional — inbox that receives applications.
# Defaults to Sociodesk.help@gmail.com if left unset.
# APPLICATIONS_TO=Sociodesk.help@gmail.com
